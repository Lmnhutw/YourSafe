                            <TextBlock AutomationProperties.AutomationId="TxtBackupSummary" Style="{StaticResource PasswordToolDescriptionStyle}" Text="{x:Bind ViewModel.Backup.Summary, Mode=OneWay}" />
                        </StackPanel>
                        <Grid x:Name="BackupSections" RowSpacing="16">
