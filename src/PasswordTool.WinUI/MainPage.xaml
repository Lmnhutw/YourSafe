<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PasswordTool_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PasswordTool_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PasswordTool.Core.Models"
    xmlns:presentation="using:PasswordTool.Presentation"
    Background="{ThemeResource WorkspaceBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="local:AppComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="VaultTabButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Background" Value="{ThemeResource VaultGroupTabBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource VaultGroupTabTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource VaultGroupTabBorderBrush}" />
        </Style>
        <Style x:Key="VaultSelectedTabButtonStyle" BasedOn="{StaticResource VaultTabButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource VaultGroupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource VaultGroupSelectedBorderBrush}" />
        </Style>
        <Style x:Key="VaultGroupTableStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource VaultGroupBackgroundBrush}" />
        </Style>
        <Style x:Key="VaultRowIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="VaultRowSymbolStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="VaultTableItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="VaultDataRowContainerStyle" BasedOn="{StaticResource VaultTableItemContainerStyle}" TargetType="ListViewItem">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewItemKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="SensitiveClipboardKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="SensitiveClipboardKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootLayout">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideItemEditor">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorSecondaryColumn.Width" Value="*" />
                        <Setter Target="EditorSections.ColumnSpacing" Value="24" />
                        <Setter Target="EditorSections.RowSpacing" Value="0" />
                        <Setter Target="EditorDetails.(Grid.Row)" Value="0" />
                        <Setter Target="EditorDetails.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowItemEditor">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="AuthenticationPanel">
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border
                    x:Name="AuthenticationCard"
                    MaxWidth="600"
                    Margin="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Padding="32"
                    Style="{StaticResource PasswordToolCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel x:Name="LoadingPanel" Spacing="12">
                            <ProgressRing IsActive="True" />
                            <TextBlock HorizontalAlignment="Center" Text="Opening YourSafe…" />
                        </StackPanel>

                        <StackPanel x:Name="PartialStoragePanel" Spacing="16" Visibility="Collapsed">
                            <FontIcon HorizontalAlignment="Left" FontSize="36" Glyph="&#xE7BA;" />
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Storage needs attention" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="YourSafe found an incomplete config/vault pair. It will not overwrite or recover over these files. Restore the missing file or inspect this app's local storage folder before continuing." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Click="ExitButton_Click" Content="Exit YourSafe" />
                        </StackPanel>

                        <StackPanel x:Name="FirstLaunchPanel" Spacing="16" Visibility="Collapsed">
                            <FontIcon HorizontalAlignment="Left" FontSize="36" Glyph="&#xE72E;" />
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Welcome to YourSafe" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Create an empty encrypted vault, or recover items from a YourSafe backup. Recovery creates a new Master Password and Authenticator for this installation." TextWrapping="Wrap" />
                            <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnCreateVault" HorizontalAlignment="Stretch" Click="CreateVaultButton_Click" Content="Create a new empty vault" />
                            <Button AutomationProperties.AutomationId="BtnRecoverVault" HorizontalAlignment="Stretch" Click="RecoverVaultButton_Click" Content="Recover from encrypted backup" />
                            <Button HorizontalAlignment="Stretch" Click="ExitButton_Click" Content="Cancel" />
                        </StackPanel>

                        <StackPanel x:Name="RecoveryPanel" Spacing="16" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Recover encrypted backup" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose a YourSafe JSON backup and enter its backup password. The file is authenticated before recovery can continue." TextWrapping="Wrap" />
                            <Button AutomationProperties.AutomationId="BtnChooseRecovery" HorizontalAlignment="Left" Click="ChooseRecoveryButton_Click" Content="Choose backup file" />
                            <TextBlock AutomationProperties.AutomationId="TxtRecoveryPath" Text="{x:Bind ViewModel.RecoveryPath, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <PasswordBox x:Name="RecoveryPassphraseInput" AutomationProperties.Name="Backup password" Header="Backup password" />
                            <Button AutomationProperties.AutomationId="BtnInspectRecovery" HorizontalAlignment="Stretch" Click="InspectRecoveryButton_Click" Content="Verify backup" />
                            <InfoBar
                                x:Name="RecoverySummaryInfoBar"
                                Message="{x:Bind ViewModel.RecoverySummary, Mode=OneWay}"
                                Severity="Success"
                                Title="Verified backup" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="BackToWelcomeButton_Click" Content="Back" />
                                <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnContinueRecovery" Click="ContinueRecoveryButton_Click" Content="Continue" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="CreateMasterPasswordPanel" Spacing="16" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Create Master Password" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Use at least 12 characters." TextWrapping="Wrap" />
                            <TextBlock Text="Save the Recovery Key shown after Authenticator verification. It can reset your Master Password and Authenticator." TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Add your first item, then create an encrypted backup." TextWrapping="Wrap" />
                            <PasswordBox x:Name="NewMasterPasswordInput" AutomationProperties.Name="New Master Password" Header="Master Password" />
                            <PasswordBox x:Name="ConfirmMasterPasswordInput" AutomationProperties.Name="Confirm Master Password" Header="Confirm Master Password" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="BackToWelcomeButton_Click" Content="Back" />
                                <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnContinueMasterPassword" Click="ContinueMasterPasswordButton_Click" Content="Continue" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SetupAuthenticatorPanel" Spacing="16" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Set up Authenticator" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Scan this QR code with a compatible 6-digit TOTP app, then enter the current code to verify setup." TextWrapping="Wrap" />
                            <Image x:Name="AuthenticatorQrImage" Width="240" Height="240" AutomationProperties.Name="Authenticator QR code" />
                            <TextBlock x:Name="AuthenticatorSecretText" AutomationProperties.AutomationId="TxtAuthenticatorSetupSecret" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Click="CopyAuthenticatorSecretButton_Click" Content="Copy setup secret securely" />
                            <local:SixDigitCodeInput x:Name="AuthenticatorConfirmationInput" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="ExitButton_Click" Content="Cancel" />
                                <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnCompleteAuthenticator" Click="CompleteAuthenticatorButton_Click" Content="Finish setup" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="UnlockPanel" Spacing="16" Visibility="Collapsed">
                            <FontIcon HorizontalAlignment="Left" FontSize="36" Glyph="&#xE72E;" />
                            <TextBlock x:Name="UnlockHeading" Text="Sign in" FontSize="32" Style="{StaticResource PasswordToolPageTitleStyle}" />
                            <TextBlock x:Name="UnlockDescription" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Enter your Master Password and Google Authenticator code to sign in." TextWrapping="Wrap" />
                            <PasswordBox x:Name="MasterPasswordInput" FontSize="18" MinHeight="44" AutomationProperties.AutomationId="TxtMasterPassword" Header="Master Password" AutomationProperties.Name="Master Password" KeyDown="MasterPasswordInput_KeyDown">
                                <PasswordBox.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="16" />
                                    </DataTemplate>
                                </PasswordBox.HeaderTemplate>
                            </PasswordBox>
                            <Button x:Name="UnlockButton" FontSize="16" MinHeight="44" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnUnlock" HorizontalAlignment="Stretch" AutomationProperties.Name="Unlock vault" Click="UnlockButton_Click" Content="Unlock" />
                            <Button FontSize="16" MinHeight="40" Content="Forgot Master Password?" Click="ForgotMasterPasswordButton_Click" />
                        </StackPanel>

                        <InfoBar
                            AutomationProperties.AutomationId="StatusUnlock"
                            IsClosable="True"
                            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Severity="Error"
                            Title="YourSafe could not continue" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Background="{ThemeResource WorkspaceBackgroundBrush}"
            AutomationProperties.AutomationId="NavShell"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="220"
            SelectionChanged="ShellNavigation_SelectionChanged"
            Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="NavVault" Content="Vault" Icon="Home" IsSelected="True" Tag="Vault" />
                <NavigationViewItem AutomationProperties.AutomationId="NavSecurityCheck" Content="Security Check" Icon="ContactInfo" Tag="SecurityCheck" />
                <NavigationViewItem AutomationProperties.AutomationId="NavBackup" Content="Backup" Icon="Save" Tag="Backup" />
                <NavigationViewItem AutomationProperties.AutomationId="NavHashTool" Content="Hash Tool" Icon="Calculator" Tag="HashTool" />
                <NavigationViewItem AutomationProperties.AutomationId="NavTrash" Content="Trash" Icon="Delete" Tag="Trash" />
                <NavigationViewItem AutomationProperties.AutomationId="NavSettings" Content="Settings" Icon="Setting" Tag="Settings" />
            </NavigationView.MenuItems>
            <Grid x:Name="WorkspaceContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar AutomationProperties.AutomationId="StatusWorkspace" Margin="24,12,24,0" IsClosable="True" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="Error" Title="Action could not complete" />
                <Grid x:Name="VaultPage" Grid.Row="1" Padding="{StaticResource PasswordToolPagePadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Vault" Style="{StaticResource PasswordToolPageTitleStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Search and manage your saved credentials."
                                TextWrapping="Wrap" />
                            <InfoBar IsOpen="{x:Bind ViewModel.IsBackupReminderOpen, Mode=TwoWay}" IsClosable="False" Title="Keep a recovery copy" Message="Create an encrypted backup of your first item." Severity="Informational">
                                <InfoBar.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Create backup" Click="BackupReminderCreate_Click" />
                                        <Button Content="Later" Click="BackupReminderLater_Click" />
                                    </StackPanel>
                                </InfoBar.Content>
                            </InfoBar>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right" MaxWidth="460">
                        <Button x:Name="VaultLockButton"
                            HorizontalAlignment="Right"
                            MinWidth="144"
                            MinHeight="44"
                            Padding="16,8"
                            AutomationProperties.AutomationId="BtnLockVault"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Lock vault"
                            Click="LockVaultButton_Click"
                            PointerEntered="VaultLockButton_PointerEntered"
                            PointerExited="VaultLockButton_PointerExited">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="VaultLockIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" Glyph="&#xE785;" />
                                <TextBlock x:Name="VaultLockLabel" FontSize="16" Text="Lock vault" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock AutomationProperties.AutomationId="TxtVaultLockHint"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsTableLocked), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" TextWrapping="Wrap"
                            Text="YourSafe's vault is locked. Unlock to avoid re-entering your password." />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,24,0,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="VaultSearchInput" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TxtVaultSearch" Header="Search" PlaceholderText="Title, username, or URL" Text="{x:Bind ViewModel.Vault.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Clear" AutomationProperties.AutomationId="BtnClearVaultFilters" Click="ClearVaultFilters_Click" IsEnabled="{x:Bind ViewModel.Vault.CanClearFilters, Mode=OneWay}" />
                        </Grid>
                        <VariableSizedWrapGrid Grid.Row="1" Orientation="Horizontal" MaximumRowsOrColumns="3">
                            <local:AppComboBox Width="150" Margin="0,0,12,8" AutomationProperties.Name="Item type filter" Header="View" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.Vault.ViewFilters}" SelectedItem="{x:Bind ViewModel.Vault.SelectedViewFilter, Mode=TwoWay}" />
                            <local:AppComboBox Width="160" Margin="0,0,12,8" AutomationProperties.Name="Sort order" Header="Sort" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.Vault.SortOrders}" SelectedItem="{x:Bind ViewModel.Vault.SelectedSortOrder, Mode=TwoWay}" />
                            <CheckBox Margin="0,24,12,8" VerticalAlignment="Center" Content="Filter by group" AutomationProperties.AutomationId="ChkFilterByGroup" IsChecked="{x:Bind ViewModel.Vault.FilterByGroup, Mode=TwoWay}" />
                        </VariableSizedWrapGrid>
                    </Grid>
                    <Grid x:Name="GroupContainer" Grid.Row="2" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="GroupTableFrame" Style="{StaticResource VaultGroupTableStyle}" Grid.Row="1" Grid.ColumnSpan="2" Padding="10" CornerRadius="8">
                            <Border Background="{ThemeResource VaultTableBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Credential table horizontal scroll">
                                    <Grid x:Name="CredentialTable" MinWidth="1208" SizeChanged="CredentialTable_SizeChanged">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="CredentialHeader" Loaded="CredentialGrid_Loaded" Padding="12,8" ColumnSpacing="20" Background="{ThemeResource VaultTableHeaderBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="1.7*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Actions" />
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Title" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Username" />
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Password" />
                                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontWeight="SemiBold" Text="2FA" />
                                            <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Notes" />
                                            <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Updated" />
                                        </Grid>
                                        <ListView x:Name="CredentialList" Grid.Row="1" Margin="0,0,0,4" AutomationProperties.Name="Vault items" ItemContainerStyle="{StaticResource VaultDataRowContainerStyle}" ItemsSource="{x:Bind ViewModel.Vault.Items, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Vault.SelectedItem, Mode=TwoWay}" SelectionMode="Single" DoubleTapped="VaultItems_DoubleTapped" KeyDown="VaultItems_KeyDown">
                                            <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="presentation:VaultItemListItem">
                                    <Grid Loaded="VaultRow_Loaded" Padding="12,6" AutomationProperties.Name="{x:Bind Title}" ColumnSpacing="20">
                                        <Grid.Resources>
                                            <Style BasedOn="{StaticResource VaultRowIconButtonStyle}" TargetType="Button" />
                                            <Style BasedOn="{StaticResource VaultRowSymbolStyle}" TargetType="FontIcon" />
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <Border Grid.Column="5" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <Border Grid.Column="6" Width="1" Height="20" Margin="-10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" IsHitTestVisible="False" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('Edit', Id)}" AutomationProperties.Name="Edit item" Click="EditRowMenuItem_Click" Padding="0" Tag="{x:Bind Id}" ToolTipService.ToolTip="Edit"><FontIcon Glyph="&#xE70F;" /></Button>
                                        <Button AutomationProperties.Name="More item actions" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('More', Id)}" Padding="0" Tag="{x:Bind Id}" Click="MoreItemActions_Click"><SymbolIcon Symbol="More" /></Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Column="2" ColumnSpacing="4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('CopyUsername', Id)}" AutomationProperties.Name="Copy username" Padding="0" Tag="{x:Bind Id}" Click="CopyUsernameRowButton_Click"><FontIcon Glyph="&#xE8C8;" /></Button>
                                    </Grid>
                                    <Grid Grid.Column="3" ColumnSpacing="4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="••••••••" Visibility="{x:Bind local:MainPage.BoolToVisibility(HasPassword), Mode=OneTime}" />
                                        <TextBlock VerticalAlignment="Center" Text="—" Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(HasPassword), Mode=OneTime}" />
                                        <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('ViewPassword', Id)}" AutomationProperties.Name="View password" Padding="0" Tag="{x:Bind Id}" Click="RevealPasswordRowButton_Click" Visibility="{x:Bind local:MainPage.BoolToVisibility(HasPassword), Mode=OneTime}"><FontIcon Glyph="&#xE890;" /></Button>
                                        <Button Grid.Column="2" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('CopyPassword', Id)}" AutomationProperties.Name="Copy password" Padding="0" Tag="{x:Bind Id}" Click="CopyPasswordRowButton_Click" Visibility="{x:Bind local:MainPage.BoolToVisibility(HasPassword), Mode=OneTime}"><FontIcon Glyph="&#xE8C8;" /></Button>
                                    </Grid>
                                    <Grid Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="—" Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(HasTotp), Mode=OneTime}" />
                                        <Button Style="{StaticResource VaultRowIconButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('ViewTotp', Id)}" AutomationProperties.Name="View verification code" ToolTipService.ToolTip="TOTP enabled" Tag="{x:Bind Id}" Click="ViewTotpRowButton_Click" Visibility="{x:Bind local:MainPage.BoolToVisibility(HasTotp), Mode=OneTime}">
                                            <!-- Microsoft Fluent System Icons: Clock20Regular. See Assets/Icons/NOTICE.md. -->
                                            <Viewbox Width="14" Height="14">
                                                <PathIcon Width="20" Height="20" Data="M10 2C14.4183 2 18 5.58172 18 10C18 14.4183 14.4183 18 10 18C5.58172 18 2 14.4183 2 10C2 5.58172 5.58172 2 10 2ZM10 3C6.13401 3 3 6.13401 3 10C3 13.866 6.13401 17 10 17C13.866 17 17 13.866 17 10C17 6.13401 13.866 3 10 3ZM9.5 5C9.74546 5 9.94961 5.17688 9.99194 5.41012L10 5.5V10H12.5C12.7761 10 13 10.2239 13 10.5C13 10.7455 12.8231 10.9496 12.5899 10.9919L12.5 11H9.5C9.25454 11 9.05039 10.8231 9.00806 10.5899L9 10.5V5.5C9 5.22386 9.22386 5 9.5 5Z" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Column="5" VerticalAlignment="Center" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Notes}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Bind local:MainPage.ItemAutomationId('ViewNotes', Id)}" AutomationProperties.Name="View notes" Click="RevealNotesRowButton_Click" Padding="0" Tag="{x:Bind Id}" ToolTipService.ToolTip="View notes" Visibility="{x:Bind local:MainPage.BoolToVisibility(HasNotes), Mode=OneTime}"><FontIcon Glyph="&#xE890;" /></Button>
                                    </Grid>
                                    <Border Grid.ColumnSpan="7" Height="1" Margin="-12,0,-12,-6" VerticalAlignment="Bottom" Background="{ThemeResource PasswordToolDividerBrush}" IsHitTestVisible="False" Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(IsLastInGroup), Mode=OneTime}" />
                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind UpdatedDisplay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                                    </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No credentials to display" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.Vault.IsEmpty), Mode=OneWay}" />
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Border>
                        <Grid x:Name="GroupTabStrip" Canvas.ZIndex="1" VerticalAlignment="Bottom" Margin="12,0,12,-1" SizeChanged="GroupTabStrip_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousGroupTab" Grid.Column="1" Margin="4,0" MinWidth="32" Padding="8" AutomationProperties.AutomationId="BtnPreviousGroupTab" AutomationProperties.Name="Previous group tabs" ToolTipService.ToolTip="Previous group tabs" Click="PreviousGroupTab_Click">
                                <FontIcon FontSize="12" Glyph="&#xE76B;" />
                            </Button>
                            <ScrollViewer x:Name="GroupTabsScroller" Grid.Column="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ViewChanged="GroupTabsScroller_ViewChanged" SizeChanged="GroupTabsScroller_SizeChanged" IsTabStop="False">
                                <StackPanel x:Name="ScrollableGroupTabs" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="AllGroupTab" Style="{StaticResource VaultTabButtonStyle}" Padding="12,8,12,16" MinHeight="48" AutomationProperties.AutomationId="Group_All" AutomationProperties.Name="All credentials" ToolTipService.ToolTip="All credentials; appearance uses the app accent" Click="GroupHeaderButton_Click" Tag="{x:Bind ViewModel.Vault.AllGroup}" KeyDown="GroupTab_KeyDown" Loaded="GroupTab_Loaded" ActualThemeChanged="GroupTab_ActualThemeChanged" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1" Text="All" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Vault.AllGroup.CountText, Mode=OneWay}" />
                                </Grid>
                            </Button>
                                <ItemsRepeater x:Name="GroupTabsRepeater" ItemsSource="{x:Bind ViewModel.Vault.GroupTabs, Mode=OneWay}" ElementPrepared="GroupTabsRepeater_ElementPrepared">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:VaultItemGroup">
                                            <Button Style="{StaticResource VaultTabButtonStyle}" Padding="12,8,12,16" MinHeight="48" MaxWidth="220" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{x:Bind local:MainPage.GroupAutomationId(Id)}" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" Click="GroupHeaderButton_Click" Tag="{x:Bind}" KeyDown="GroupTab_KeyDown" Loaded="GroupTab_Loaded" ActualThemeChanged="GroupTab_ActualThemeChanged">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" />
                                                </Grid>
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="RenameGroupMenuItem_Click" Tag="{x:Bind}" Text="Rename tab" />
                                                        <MenuFlyoutItem Click="ChangeGroupColorMenuItem_Click" Tag="{x:Bind}" Text="Change tab color" />
                                                        <MenuFlyoutItem Click="DeleteGroupMenuItem_Click" Tag="{x:Bind}" Text="Delete group" />
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="NextGroupTab" Grid.Column="3" Margin="4,0" MinWidth="32" Padding="8" AutomationProperties.AutomationId="BtnNextGroupTab" AutomationProperties.Name="Next group tabs" ToolTipService.ToolTip="Next group tabs" Click="NextGroupTab_Click">
                                <FontIcon FontSize="12" Glyph="&#xE76C;" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="VaultActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                            <Button AutomationProperties.AutomationId="BtnAddGroup" AutomationProperties.Name="Create group" Click="AddGroupButton_Click" Content="New Group" />
                            <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnAddItem" AutomationProperties.Name="Add vault item" Click="AddItemButton_Click" Content="Add item" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="TrashPage" Grid.Row="1" Padding="24" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Trash" />
                            <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Restore deleted items or remove them permanently from this vault." />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" AutomationProperties.AutomationId="BtnCloseTrash" Click="CloseTrashButton_Click" Content="Back to Vault" />
                    </Grid>
                    <ListView Grid.Row="1" Margin="0,16,0,12" AutomationProperties.Name="Deleted vault items" ItemsSource="{x:Bind ViewModel.Trash.Items}" SelectedItem="{x:Bind ViewModel.Trash.SelectedItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:TrashItemListItem">
                                <Grid Padding="12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Type}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DeletedAt}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind local:MainPage.EmptyVisibility(ViewModel.Trash.Items.Count), Mode=OneWay}">
                        <TextBlock Text="Trash is empty" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Items you delete from the vault will appear here." Style="{StaticResource PasswordToolDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind local:MainPage.HasSelection(ViewModel.Trash.SelectedItem), Mode=OneWay}" Click="RestoreTrashButton_Click" Content="Restore selected" />
                        <Button IsEnabled="{x:Bind local:MainPage.HasSelection(ViewModel.Trash.SelectedItem), Mode=OneWay}" Click="DeleteTrashPermanentlyButton_Click" Content="Delete permanently" />
                    </StackPanel>
                    <InfoBar Grid.Row="3" IsClosable="True" IsOpen="{x:Bind ViewModel.Trash.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Trash.ErrorMessage, Mode=OneWay}" Severity="Error" Title="Trash operation could not continue" />
                </Grid>

                <ScrollViewer x:Name="EditorPage" Grid.Row="1" MaxWidth="1024" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" IsEnabled="{x:Bind local:MainPage.CanEditItem(ViewModel.IsSavingItem, ViewModel.IsTableLocked), Mode=OneWay}">
                    <Grid Margin="24" RowSpacing="24" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource PasswordToolPageTitleStyle}" Text="Add item" />
                            <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Save a password, recovery codes, and the details you need to find them later." />
                        </StackPanel>
                        <Grid x:Name="EditorSections" Grid.Row="1" RowSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="EditorSecondaryColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="EditorCredentials" Style="{StaticResource PasswordToolCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="EditorItemTitle" AutomationProperties.AutomationId="TxtEditorTitle" AutomationProperties.Name="Item title" Header="Title" />
                                    <TextBox x:Name="EditorUsername" AutomationProperties.AutomationId="TxtEditorUsername" AutomationProperties.Name="Username (required)" Header="Username (required)" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="EditorPassword" AutomationProperties.AutomationId="TxtEditorPassword" AutomationProperties.Name="Password" Header="Password" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" AutomationProperties.AutomationId="BtnGeneratePassword" AutomationProperties.Name="Generate a password or passphrase" Click="GeneratePasswordButton_Click" Content="Generate" />
                                    </Grid>
                                    <StackPanel x:Name="EditorTotpSection" Spacing="8">
                                        <TextBlock Text="TOTP verification codes" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EditorTotpStatus" Text="No TOTP configured" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="EditorTotpButton" AutomationProperties.AutomationId="BtnEditorTotp" Click="EditTotpButton_Click" Content="Add TOTP" />
                                            <Button x:Name="EditorRemoveTotpButton" AutomationProperties.AutomationId="BtnRemoveTotp" Click="RemoveTotpButton_Click" Content="Remove" Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock Text="Changes are saved with Save item." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox x:Name="EditorRecoveryCodes" AutomationProperties.AutomationId="TxtEditorRecoveryCodes" AcceptsReturn="True" AutomationProperties.Name="Recovery codes" ContextMenuOpening="SensitiveTextBox_ContextMenuOpening" Header="Recovery codes, one per line" Height="140" Tag="SensitiveInput" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="EditorDetails" Grid.Row="1" Style="{StaticResource PasswordToolCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Details and organization" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EditorUrl" AutomationProperties.AutomationId="TxtEditorUrl" AutomationProperties.Name="URL (required unless No URL is checked)" Header="URL (required)" />
                                        <CheckBox x:Name="EditorNoUrl" Grid.Column="1" MinWidth="0" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ChkEditorNoUrl" AutomationProperties.Name="No URL" Checked="EditorNoUrl_Changed" Unchecked="EditorNoUrl_Changed" Content="No URL" />
                                    </Grid>
                                    <local:AppComboBox x:Name="EditorGroup" AutomationProperties.AutomationId="CmbEditorGroup" AutomationProperties.Name="Group" DisplayMemberPath="Label" Header="Group" ItemsSource="{x:Bind ViewModel.Vault.GroupOptions, Mode=OneWay}" />
                                    <TextBox x:Name="EditorTags" AutomationProperties.AutomationId="TxtEditorTags" AutomationProperties.Name="Tags" Header="Tags, comma separated" />
                                    <TextBox x:Name="EditorNotes" AutomationProperties.AutomationId="TxtEditorNotes" AcceptsReturn="True" AutomationProperties.Name="Notes" ContextMenuOpening="SensitiveTextBox_ContextMenuOpening" Header="Notes" Height="96" Tag="SensitiveInput" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="EditorFavorite" MinWidth="0" VerticalAlignment="Top" AutomationProperties.AutomationId="ChkEditorFavorite">
                                            <TextBlock Text="Favorite" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox x:Name="EditorHideUrl" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" AutomationProperties.AutomationId="ChkEditorHideUrl">
                                            <TextBlock Text="Hide URL in list" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox x:Name="EditorHideNotes" Grid.Column="2" MinWidth="0" VerticalAlignment="Top" AutomationProperties.AutomationId="ChkEditorHideNotes">
                                            <TextBlock Text="Hide notes in list" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="BtnCancelItem" Click="CancelEditorButton_Click" Content="Cancel" />
                            <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnSaveItem" Click="SaveEditorButton_Click" Content="Save item" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="HashToolPage" Grid.Row="1" MaxWidth="960" Margin="24" HorizontalAlignment="Stretch" Visibility="Collapsed" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Password Hash Tool" />
                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Generate a password hash, check a password, or inspect an existing hash. All processing stays on this device." />
                    </StackPanel>
                    <SelectorBar x:Name="HashModeSelector" Grid.Row="1" AutomationProperties.Name="Hash operation" SelectionChanged="HashModeSelector_SelectionChanged">
                        <SelectorBarItem Text="Generate" IsSelected="True" AutomationProperties.AutomationId="HashModeGenerate" />
                        <SelectorBarItem Text="Verify" AutomationProperties.AutomationId="HashModeVerify" />
                        <SelectorBarItem Text="Inspect" AutomationProperties.AutomationId="HashModeInspect" />
                    </SelectorBar>
                    <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource PasswordToolCardStyle}" VerticalAlignment="Top">
                            <Grid>
                                <StackPanel x:Name="HashGeneratePanel" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Generate a hash" />
                                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Choose an algorithm and enter the password to hash. Legacy algorithms are for learning only." />
                                    </StackPanel>
                                    <local:AppComboBox AutomationProperties.AutomationId="CmbHashAlgorithm" Header="Algorithm" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.HashTool.Algorithms}" SelectedItem="{x:Bind ViewModel.HashTool.SelectedAlgorithm, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="{x:Bind ViewModel.HashTool.SelectedAlgorithm.Description, Mode=OneWay, FallbackValue=''}" />
                                    <PasswordBox x:Name="HashGeneratePassword" AutomationProperties.AutomationId="TxtHashGeneratePassword" AutomationProperties.Name="Password to hash" Header="Password" />
                                    <Button AutomationProperties.AutomationId="BtnGenerateHash" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="GenerateHashButton_Click" Content="Generate hash" />
                                    <TextBox AutomationProperties.AutomationId="TxtGeneratedHash" AutomationProperties.Name="Generated hash" Header="Generated hash" Style="{StaticResource PasswordToolHashInputStyle}" IsReadOnly="True" Text="{x:Bind ViewModel.HashTool.GeneratedHash, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="HashVerifyPanel" Spacing="16" Visibility="Collapsed">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Verify a password" />
                                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Compare a password with a stored hash. The hash format is detected automatically." />
                                    </StackPanel>
                                    <PasswordBox x:Name="HashVerifyPassword" AutomationProperties.AutomationId="TxtHashVerifyPassword" AutomationProperties.Name="Password to verify" Header="Password" />
                                    <TextBox x:Name="HashVerifyStored" AutomationProperties.AutomationId="TxtHashVerifyStored" AutomationProperties.Name="Stored hash" Header="Stored hash" Style="{StaticResource PasswordToolHashInputStyle}" TextWrapping="Wrap" />
                                    <Button AutomationProperties.AutomationId="BtnVerifyHash" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="VerifyHashButton_Click" Content="Verify password" />
                                    <TextBlock AutomationProperties.AutomationId="TxtHashVerificationResult" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.HashTool.VerificationResult, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="HashInspectPanel" Spacing="16" Visibility="Collapsed">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Inspect a hash" />
                                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Read the algorithm and parameters encoded in a hash. No password is required." />
                                    </StackPanel>
                                    <TextBox x:Name="HashInspectStored" AutomationProperties.AutomationId="TxtHashInspectStored" AutomationProperties.Name="Hash to inspect" Header="Stored hash" Style="{StaticResource PasswordToolHashInputStyle}" TextWrapping="Wrap" />
                                    <Button AutomationProperties.AutomationId="BtnInspectHash" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="InspectHashButton_Click" Content="Inspect hash" />
                                    <TextBlock x:Name="HashInspectionText" AutomationProperties.AutomationId="TxtHashInspectionResult" AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                    <InfoBar
                        x:Name="HashErrorInfoBar"
                        Grid.Row="3"
                        Message="{x:Bind ViewModel.HashTool.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        Title="Hash operation could not continue" />
                </Grid>

                <ScrollViewer x:Name="BackupPage" Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.Backup.IsBusy), Mode=OneWay}">
                    <StackPanel Style="{StaticResource PasswordToolFormStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Backup &amp; Recovery" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Encrypted backups include items in Trash. Keep a copy outside this device. Plaintext CSV is import-only." TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.Backup.IsBusy), Mode=OneWay}" AutomationProperties.Name="Processing backup operation" />
                            <InfoBar IsClosable="True" IsOpen="{x:Bind ViewModel.Backup.IsStatusOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Backup.StatusMessage, Mode=OneWay}" Severity="Informational" Title="Backup &amp; Recovery" />
                            <TextBlock Text="{x:Bind ViewModel.Backup.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid x:Name="BackupSections" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="BackupSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PasswordToolCardStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Encrypted backup" />
                                    <TextBlock Text="Use at least 12 characters for your backup password." TextWrapping="Wrap" />
                                    <PasswordBox x:Name="BackupPassphrase" Password="{x:Bind ViewModel.Backup.BackupPassword, Mode=TwoWay}" AutomationProperties.Name="Backup password" Header="Backup password" />
                                    <TextBlock Text="This password protects your backup independently of your Master Password. Keep it somewhere safe—you’ll need it to restore." TextWrapping="Wrap" />
                                    <PasswordBox x:Name="BackupPassphraseConfirmation" Password="{x:Bind ViewModel.Backup.ConfirmBackupPassword, Mode=TwoWay}" AutomationProperties.Name="Confirm backup password" Header="Confirm backup password for creation" />
                                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="ExportBackupButton_Click" Content="Create backup" />
                                    <Button HorizontalAlignment="Right" Click="VerifyBackupButton_Click" Content="Verify backup file" />
                                    <TextBlock Text="Creation verifies the saved file. Verify it again later to check that it is still readable." TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Right" Click="PreviewBackupImportButton_Click" Content="Preview backup import" />
                                    <Button HorizontalAlignment="Right" Click="ImportBackupButton_Click" Content="Import previewed new items" IsEnabled="{x:Bind ViewModel.Backup.CanImportBackup, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CsvImportSection" Grid.Column="1" Style="{StaticResource PasswordToolCardStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="CSV import" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Review a bounded browser/password-manager CSV, then add only accounts that do not already match." TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Right" Click="PreviewCsvButton_Click" Content="Preview CSV" />
                                    <Button HorizontalAlignment="Right" Click="ImportCsvButton_Click" Content="Import previewed new items" IsEnabled="{x:Bind ViewModel.Backup.CanImportCsv, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Local snapshots" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Snapshots are prior encrypted config/vault pairs on this device. Restoring returns YourSafe to Unlock." TextWrapping="Wrap" />
                                <ListView Height="180" ItemsSource="{x:Bind ViewModel.Backup.Snapshots}" SelectedItem="{x:Bind ViewModel.Backup.SelectedSnapshot, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:VaultSnapshotInfo">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind SecurityStateLabel}" TextWrapping="Wrap" />
                                            <StackPanel Padding="8,6">
                                                <TextBlock Text="{x:Bind CreatedAtUtc}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Id}" />
                                            </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <PasswordBox x:Name="SnapshotMasterPassword" AutomationProperties.Name="Master Password for snapshot restore" Header="Current Master Password" />
                                <Button HorizontalAlignment="Right" Click="RestoreSnapshotButton_Click" Content="Restore selected snapshot" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="SecurityCheckPage" Grid.Row="1" Padding="24" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Local Security Check" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Passwords are compared only inside this process and are never included in findings." TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.SecurityCheck.IsBusy), Mode=OneWay}" Click="RunSecurityCheckButton_Click" Content="Run check" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.SecurityCheck.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView AutomationProperties.Name="Security Check findings" ItemsSource="{x:Bind ViewModel.SecurityCheck.Findings}" SelectedItem="{x:Bind ViewModel.SecurityCheck.SelectedFinding, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultSecurityFinding">
                                    <Grid Padding="12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayLabel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Recommendation}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" IsEnabled="{x:Bind local:MainPage.HasSelection(ViewModel.SecurityCheck.SelectedFinding), Mode=OneWay}" Click="EditSecurityFindingButton_Click" Content="Edit selected item" />
                    </Grid>
                    <InfoBar Grid.Row="3" IsClosable="True" IsOpen="{x:Bind ViewModel.SecurityCheck.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.SecurityCheck.ErrorMessage, Mode=OneWay}" Severity="Error" Title="Security Check could not run" />
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PasswordToolFormStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Settings" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Security-sensitive changes require the current Master Password." TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Appearance" />
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Appearance is saved on this device." />
                                <local:AppComboBox x:Name="AppThemeInput" Header="Background" AutomationProperties.AutomationId="CmbAppTheme" AutomationProperties.Name="App background" SelectionChanged="AppearanceSelection_Changed">
                                    <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
                                </local:AppComboBox>
                                <local:AppComboBox x:Name="GroupTabPlacement" Header="Vault layout" AutomationProperties.AutomationId="CmbGroupTabPlacement" AutomationProperties.Name="Vault layout" SelectionChanged="GroupTabPlacement_SelectionChanged">
                                    <ComboBoxItem Content="Horizontal" /><ComboBoxItem Content="Vertical" />
                                </local:AppComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Login and timeouts" />
                                <TextBlock Text="Application Login Session — fixed 5 hours" />
                                <local:AppComboBox x:Name="VaultDurationInput" Header="Keep vault unlocked for" SelectedIndex="0">
                                    <ComboBoxItem Content="1 minute" /><ComboBoxItem Content="2 minutes" />
                                    <ComboBoxItem Content="5 minutes" /><ComboBoxItem Content="10 minutes" />
                                    <ComboBoxItem Content="30 minutes" /><ComboBoxItem Content="1 hour" />
                                    <ComboBoxItem Content="2 hours" /><ComboBoxItem Content="5 hours" />
                                </local:AppComboBox>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The timer starts when you unlock YourSafe's vault. Restart YourSafe to apply changes." TextWrapping="Wrap" />
                                <PasswordBox x:Name="SettingsMasterPassword" AutomationProperties.Name="Master Password for settings" Header="Current Master Password" />
                                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveSettingsButton_Click" Content="Save security settings" />
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Recovery code" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Use this code if you forget your Master Password. Create a new code if you need to replace the one you saved." TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Right" Click="RotateRecoveryKeyButton_Click" Content="Create a new recovery code" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Settings.BackupHealthText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Master Password" />
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Choose a new Master Password with at least 12 characters." />
                                <PasswordBox x:Name="CurrentMasterPassword" AutomationProperties.Name="Current Master Password" Header="Current Master Password" />
                                <PasswordBox x:Name="ReplacementMasterPassword" AutomationProperties.Name="New Master Password" Header="New Master Password" />
                                <PasswordBox x:Name="ConfirmReplacementMasterPassword" AutomationProperties.Name="Confirm new Master Password" Header="Confirm new Master Password" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Password protection" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button AutomationProperties.AutomationId="BtnPasswordProtectionHelp" AutomationProperties.Name="About password protection" Background="Transparent" BorderThickness="0" Padding="4" MinWidth="24" MinHeight="24">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Padding="16">
                                                <TextBlock MaxWidth="340" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Text="Password protection (KDF) makes guessing your password harder if someone copies your vault. Upgrading strengthens this protection without changing your Master Password or saved items." />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Your password protection is up to date." Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.Settings.NeedsKdfUpgrade), Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="BtnUpgradePasswordProtection" HorizontalAlignment="Right" Click="UpgradeKdfButton_Click" Content="Upgrade password protection (KDF)" IsEnabled="{x:Bind ViewModel.Settings.NeedsKdfUpgrade, Mode=OneWay}" />
                                        <Button Style="{StaticResource AccentButtonStyle}" Click="ChangeMasterPasswordButton_Click" Content="Change Master Password" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Authenticator" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Generate a replacement setup, scan it, and confirm the new 6-digit code. Existing trusted tokens are replaced only after successful verification." TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Right" Click="PrepareAuthenticatorResetButton_Click" Content="Prepare replacement Authenticator" />
                                <Image x:Name="SettingsAuthenticatorQr" Width="220" Height="220" Visibility="Collapsed" />
                                <TextBlock x:Name="SettingsAuthenticatorSecret" FontFamily="Consolas" TextWrapping="Wrap" />
                                <PasswordBox x:Name="AuthenticatorResetMasterPassword" AutomationProperties.Name="Master Password for Authenticator reset" Header="Current Master Password" />
                                <local:SixDigitCodeInput x:Name="AuthenticatorResetCode" />
                                <Button HorizontalAlignment="Right" Click="ResetAuthenticatorButton_Click" Content="Reset Authenticator" />
                            </StackPanel>
                        </Border>

                        <InfoBar
                            IsClosable="True"
                            IsOpen="{x:Bind ViewModel.Settings.IsStatusOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.Settings.StatusMessage, Mode=OneWay}"
                            Severity="Informational"
                            Title="Settings" />
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </NavigationView>
    </Grid>
</Page>
