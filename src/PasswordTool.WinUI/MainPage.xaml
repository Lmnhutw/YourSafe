                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock AutomationProperties.AutomationId="TxtHashVerificationResult" AutomationProperties.LiveSetting="Polite" Style="{StaticResource PasswordToolDescriptionStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.HashTool.VerificationResult, Mode=OneWay}" />
                                        <Button Grid.Column="1" AutomationProperties.AutomationId="BtnVerifyHash" Style="{StaticResource AccentButtonStyle}" Click="VerifyHashButton_Click" Content="Verify password" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="HashInspectPanel" Spacing="16" Visibility="Collapsed">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Inspect a hash" />
                                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Read the algorithm and parameters encoded in a hash. No password is required." />
                                    </StackPanel>
                                    <TextBox x:Name="HashInspectStored" AutomationProperties.AutomationId="TxtHashInspectStored" AutomationProperties.Name="Hash to inspect" Header="Stored hash" Style="{StaticResource PasswordToolHashInputStyle}" TextWrapping="Wrap" />
