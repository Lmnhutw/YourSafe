                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="BackupSecondaryColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PasswordToolCardStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="20">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock AutomationProperties.AutomationId="TxtEncryptedBackupTitle" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Text="Encrypted backup" />
                                        <Button Grid.Column="1" Width="32" Height="32" MinWidth="32" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="BtnBackupHelp" AutomationProperties.Name="About encrypted backups" AutomationProperties.HelpText="Backups include items in Trash. Keep the backup password safe; you need it to restore the file. Creating a backup also verifies it.">
                                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                                            <ToolTipService.ToolTip><ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="Backups include items in Trash. Keep the backup password safe; you need it to restore the file. Creating a backup also verifies it." /></ToolTip></ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                    <StackPanel Spacing="8">
                                        <PasswordBox x:Name="BackupPassphrase" Password="{x:Bind ViewModel.Backup.BackupPassword, Mode=TwoWay}" AutomationProperties.AutomationId="TxtBackupPassword" AutomationProperties.Name="Backup password" Header="Backup password" />
                                        <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="At least 12 characters. Separate from your Master Password." />
                                    </StackPanel>
                                    <PasswordBox x:Name="BackupPassphraseConfirmation" Password="{x:Bind ViewModel.Backup.ConfirmBackupPassword, Mode=TwoWay}" AutomationProperties.AutomationId="TxtConfirmBackupPassword" AutomationProperties.Name="Confirm backup password for creation" Header="Confirm backup password" ToolTipService.ToolTip="Confirmation is only required when creating a backup." AutomationProperties.HelpText="Confirmation is only required when creating a backup." />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.AutomationId="BtnVerifyBackup" AutomationProperties.Name="Verify backup file" Click="VerifyBackupButton_Click" Content="Verify file" ToolTipService.ToolTip="Check that an existing backup is still readable using its backup password." />
                                        <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BtnCreateBackup" Click="ExportBackupButton_Click" Content="Create backup" />
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Spacing="12">
                                        <TextBlock FontWeight="SemiBold" Text="Import from backup" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.AutomationId="BtnPreviewBackup" AutomationProperties.Name="Preview backup import" Click="PreviewBackupImportButton_Click" Content="Preview import" ToolTipService.ToolTip="Choose a backup and preview new items using its backup password. Existing items will stay unchanged." />
                                            <Button AutomationProperties.AutomationId="BtnImportBackup" AutomationProperties.Name="Import previewed new items from backup" Click="ImportBackupButton_Click" Content="Import new items" IsEnabled="{x:Bind ViewModel.Backup.CanImportBackup, Mode=OneWay}" ToolTipService.ToolTip="Import the new items from the latest backup preview." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CsvImportSection" Grid.Row="1" Style="{StaticResource PasswordToolCardStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="20">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock AutomationProperties.AutomationId="TxtCsvImportTitle" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Text="CSV import" />
                                        <Button Grid.Column="1" Width="32" Height="32" MinWidth="32" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="BtnCsvImportHelp" AutomationProperties.Name="About CSV imports" AutomationProperties.HelpText="Preview passwords from a browser or password manager before importing. Matching accounts are skipped; existing items stay unchanged.">
                                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                                            <ToolTipService.ToolTip><ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="Preview passwords from a browser or password manager before importing. Matching accounts are skipped; existing items stay unchanged." /></ToolTip></ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="CSV files are not encrypted. Keep them safe and delete them after import." />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.AutomationId="BtnPreviewCsv" Click="PreviewCsvButton_Click" Content="Preview CSV" />
                                        <Button AutomationProperties.AutomationId="BtnImportCsv" AutomationProperties.Name="Import previewed new items from CSV" Click="ImportCsvButton_Click" Content="Import new items" IsEnabled="{x:Bind ViewModel.Backup.CanImportCsv, Mode=OneWay}" ToolTipService.ToolTip="Import the new items from the latest CSV preview." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="20">
                                <TextBlock AutomationProperties.AutomationId="TxtLocalSnapshotsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Local snapshots" />
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Restore an earlier encrypted copy saved on this device. This replaces your vault and security settings and returns you to sign in." />
                                    <TextBlock FontWeight="SemiBold" Text="Older snapshots can restore previous credentials." TextWrapping="Wrap" />
                                </StackPanel>
                                <ListView AutomationProperties.AutomationId="ListLocalSnapshots" AutomationProperties.Name="Local snapshots" Height="180" ItemsSource="{x:Bind ViewModel.Backup.Snapshots}" SelectedItem="{x:Bind ViewModel.Backup.SelectedSnapshot, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:VaultSnapshotInfo">
                                            <StackPanel Padding="0,6" Spacing="4" ToolTipService.ToolTip="{x:Bind Id}" AutomationProperties.HelpText="{x:Bind Id}">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind SecurityStateLabel}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="{x:Bind CreatedAtUtc}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <PasswordBox x:Name="SnapshotMasterPassword" AutomationProperties.AutomationId="TxtSnapshotMasterPassword" AutomationProperties.Name="Master Password for snapshot restore" Header="Current Master Password" />
                                <Button AutomationProperties.AutomationId="BtnRestoreSnapshot" HorizontalAlignment="Right" Click="RestoreSnapshotButton_Click" Content="Restore selected snapshot" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="SecurityCheckPage" Grid.Row="1" Padding="24" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Local Security Check" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Passwords are checked on your device and never shown in the results." TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.SecurityCheck.IsBusy), Mode=OneWay}" Click="RunSecurityCheckButton_Click" Content="Run check" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.SecurityCheck.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView AutomationProperties.Name="Security Check results" ItemsSource="{x:Bind ViewModel.SecurityCheck.Findings}" SelectedItem="{x:Bind ViewModel.SecurityCheck.SelectedFinding, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultSecurityFinding">
                                    <Grid Padding="12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayLabel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Recommendation}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" IsEnabled="{x:Bind local:MainPage.HasSelection(ViewModel.SecurityCheck.SelectedFinding), Mode=OneWay}" Click="EditSecurityFindingButton_Click" Content="Edit selected item" />
                    </Grid>
                    <InfoBar Grid.Row="3" IsClosable="True" IsOpen="{x:Bind ViewModel.SecurityCheck.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.SecurityCheck.ErrorMessage, Mode=OneWay}" Severity="Error" Title="Security Check could not run" />
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PasswordToolFormStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PasswordToolPageTitleStyle}" Text="Settings" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Enter your current Master Password to change security settings." TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Appearance" />
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Appearance is saved on this device." />
                                <local:AppComboBox x:Name="AppThemeInput" Header="Background" AutomationProperties.AutomationId="CmbAppTheme" AutomationProperties.Name="App background" SelectionChanged="AppearanceSelection_Changed">
                                    <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
                                </local:AppComboBox>
                                <local:AppComboBox x:Name="GroupTabPlacement" Header="Vault layout" AutomationProperties.AutomationId="CmbGroupTabPlacement" AutomationProperties.Name="Vault layout" SelectionChanged="GroupTabPlacement_SelectionChanged">
                                    <ComboBoxItem Content="Horizontal" /><ComboBoxItem Content="Vertical" />
                                </local:AppComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock AutomationProperties.AutomationId="TxtSignInVaultLockTitle" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Sign-in and vault lock" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" AutomationProperties.AutomationId="BtnSessionHelp" AutomationProperties.Name="About the YourSafe session" AutomationProperties.HelpText="YourSafe session lasts 5 hours from sign-in. When it ends, sign in again with your Master Password and Authenticator code. Vault lock has a separate timer; unlocking during this session only requires your Master Password." Background="Transparent" BorderThickness="0" Padding="4" MinWidth="24" MinHeight="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap" Text="YourSafe session lasts 5 hours from sign-in. When it ends, sign in again with your Master Password and Authenticator code. Vault lock has a separate timer; unlocking during this session only requires your Master Password." />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </Grid>
                                <local:AppComboBox x:Name="VaultDurationInput" Header="Keep vault unlocked for" AutomationProperties.AutomationId="CmbVaultDuration" SelectedIndex="0">
                                    <ComboBoxItem Content="1 minute" /><ComboBoxItem Content="2 minutes" />
                                    <ComboBoxItem Content="5 minutes" /><ComboBoxItem Content="10 minutes" />
                                    <ComboBoxItem Content="30 minutes" /><ComboBoxItem Content="1 hour" />
                                    <ComboBoxItem Content="2 hours" /><ComboBoxItem Content="5 hours" />
                                </local:AppComboBox>
                                <TextBlock AutomationProperties.AutomationId="TxtVaultLockDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" Text="Your vault locks after this time, starting when you unlock it. Restart YourSafe to apply changes." TextWrapping="Wrap" />
                                <PasswordBox x:Name="SettingsMasterPassword" AutomationProperties.Name="Master Password for settings" Header="Current Master Password" />
                                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveSettingsButton_Click" Content="Save security settings" />
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Recovery Key" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Use your Recovery Key to reset your Master Password and Authenticator. Create a new key if you need to replace the one you saved." TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Right" Click="RotateRecoveryKeyButton_Click" Content="Create a new Recovery Key" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Settings.BackupHealthText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Master Password" />
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Choose a new Master Password with at least 12 characters." />
                                <PasswordBox x:Name="CurrentMasterPassword" AutomationProperties.Name="Current Master Password" Header="Current Master Password" />
                                <PasswordBox x:Name="ReplacementMasterPassword" AutomationProperties.Name="New Master Password" Header="New Master Password" />
                                <PasswordBox x:Name="ConfirmReplacementMasterPassword" AutomationProperties.Name="Confirm new Master Password" Header="Confirm new Master Password" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Password protection" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button AutomationProperties.AutomationId="BtnPasswordProtectionHelp" AutomationProperties.Name="About password protection" Background="Transparent" BorderThickness="0" Padding="4" MinWidth="24" MinHeight="24">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Padding="16">
                                                <TextBlock MaxWidth="340" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Text="Password protection (KDF) makes guessing your password harder if someone copies your vault. Upgrading strengthens this protection without changing your Master Password or saved items." />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource PasswordToolDescriptionStyle}" Text="Your password protection is up to date." Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.Settings.NeedsKdfUpgrade), Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="BtnUpgradePasswordProtection" HorizontalAlignment="Right" Click="UpgradeKdfButton_Click" Content="Upgrade password protection" IsEnabled="{x:Bind ViewModel.Settings.NeedsKdfUpgrade, Mode=OneWay}" />
                                        <Button AutomationProperties.AutomationId="BtnChangeMasterPassword" Style="{StaticResource AccentButtonStyle}" Click="ChangeMasterPasswordButton_Click" Content="Change Master Password" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PasswordToolCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Authenticator" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Set up a new Authenticator by scanning the QR code and entering its 6-digit code. Your current Authenticator stays active until you verify the new one." TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Right" Click="PrepareAuthenticatorResetButton_Click" Content="Change Authenticator" />
                                <Image x:Name="SettingsAuthenticatorQr" Width="220" Height="220" Visibility="Collapsed" />
                                <TextBlock x:Name="SettingsAuthenticatorSecret" FontFamily="Consolas" TextWrapping="Wrap" />
                                <PasswordBox x:Name="AuthenticatorResetMasterPassword" AutomationProperties.Name="Master Password for Authenticator reset" Header="Current Master Password" />
                                <local:SixDigitCodeInput x:Name="AuthenticatorResetCode" />
                                <Button HorizontalAlignment="Right" Click="ResetAuthenticatorButton_Click" Content="Verify new Authenticator" />
                            </StackPanel>
                        </Border>

                        <InfoBar
                            IsClosable="True"
                            IsOpen="{x:Bind ViewModel.Settings.IsStatusOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.Settings.StatusMessage, Mode=OneWay}"
                            Severity="Informational"
                            Title="Settings" />
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </NavigationView>
    </Grid>
</Page>
