{
  "theme": "base",
  "securityLevel": "strict",
  "htmlLabels": false,
  "themeCSS": "rect.rect{stroke-dasharray:5 4 !important;}",
  "fontFamily": "Segoe UI, Arial, sans-serif",
  "themeVariables": {
    "background": "#ffffff",
    "fontFamily": "Segoe UI, Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#f8fafc",
    "primaryTextColor": "#0f172a",
    "primaryBorderColor": "#64748b",
    "secondaryColor": "#eff6ff",
    "tertiaryColor": "#ffffff",
    "lineColor": "#64748b",
    "textColor": "#0f172a",
    "mainBkg": "#f8fafc",
    "nodeBorder": "#64748b",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#94a3b8",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#eff6ff",
    "actorBorder": "#2563eb",
    "actorTextColor": "#0f172a",
    "actorLineColor": "#94a3b8",
    "signalColor": "#475569",
    "signalTextColor": "#0f172a",
    "labelBoxBkgColor": "#f8fafc",
    "labelBoxBorderColor": "#94a3b8",
    "labelTextColor": "#0f172a",
    "loopTextColor": "#0f172a",
    "noteBkgColor": "#fffbeb",
    "noteBorderColor": "#d97706",
    "noteTextColor": "#0f172a"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 24,
    "rankSpacing": 20,
    "padding": 10,
    "wrappingWidth": 115,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "actorMargin": 45,
    "messageMargin": 30,
    "width": 175,
    "height": 46,
    "wrap": true
  },
  "state": { "useMaxWidth": false }
}
