flowchart LR
    accTitle: Save a credential
    accDescr: The desktop validates an unlocked editor draft, encrypts the vault with the DEK, and stages a paired commit. Failure rolls back; success persists ciphertext and config metadata.
    subgraph desktop["Desktop App"]
        direction LR
        edit["`Edit credential`"]:::secret --> ready{"`Unlocked and valid?`"}:::decision
        ready -->|No| denied["Reject save"]:::danger
        ready -->|Yes| encrypt["`Encrypt and stage`"]
        encrypt --> result{"`Commit succeeds?`"}:::decision
        result -->|Failure| rollback["Roll back change"]:::danger
    end
    subgraph localVault["Local Vault"]
        pair[("`Vault pair`")]:::encrypted
    end
    result -->|Success| pair
    classDef secret fill:#fffbeb,stroke:#d97706,color:#0f172a
    classDef decision fill:#fffbeb,stroke:#d97706,color:#0f172a
    classDef encrypted fill:#eff6ff,stroke:#2563eb,color:#0f172a
    classDef danger fill:#fef2f2,stroke:#dc2626,color:#991b1b
    style desktop stroke-dasharray:5 4
    style localVault stroke-dasharray:5 4
