flowchart LR
    accTitle: Recover entries on a fresh installation
    accDescr: Recovery requires both local vault files to be absent. The backup passphrase authenticates the backup, new credentials and Recovery Key are confirmed, then a new DEK and vault pair are committed. Failures stop; no existing vault is overwritten.
    subgraph desktop["Desktop App / Core"]
        direction LR
        empty{"`Storage empty?`"}:::decision
        inspect["`Decrypt backup + inspect`"]:::secret
        setup["`Confirm new credentials`"]
        create["`New DEK + encrypt`"]
        commit{"Success?"}:::decision
        stop["`Stop / report failure`"]:::danger
    end
    subgraph localVault["Local Vault"]
        pair[("`New vault pair`")]:::encrypted
    end
    empty -->|No| stop
    empty -->|Yes| inspect
    inspect -->|Valid| setup
    inspect -->|Invalid| stop
    setup -->|Confirmed| create
    setup -->|Cancel / invalid| stop
    create --> commit
    commit -->|Failure| stop
    commit -->|Success| pair
    classDef secret fill:#fffbeb,stroke:#d97706,color:#0f172a
    classDef decision fill:#fffbeb,stroke:#d97706,color:#0f172a
    classDef encrypted fill:#eff6ff,stroke:#2563eb,color:#0f172a
    classDef danger fill:#fef2f2,stroke:#dc2626,color:#991b1b
    style desktop stroke-dasharray:5 4
    style localVault stroke-dasharray:5 4
